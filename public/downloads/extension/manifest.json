{
  "manifest_version": 3,
  "name": "Arcade Interactive Demo & DOM Recorder",
  "version": "2.4.0",
  "description": "Capture browser clicks, normalized hotspot coordinates, and DOM metadata into your Arcade Studio.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Record Interactive Demo with Arcade"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
