DATABASE_URL="file:./dev.db"
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 48. Never reuse an example or shared secret.
NEXTAUTH_SECRET=""
ARCADE_STORAGE_DIR="./storage"

# Optional: real AI storyboards, copy refinement and translation.
AZURE_OPENAI_ENDPOINT=""
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_DEPLOYMENT=""
AZURE_OPENAI_API_VERSION="2024-10-21"

# Optional: real neural speech. Without both values, narration returns unavailable.
AZURE_SPEECH_KEY=""
AZURE_SPEECH_REGION=""
AZURE_SPEECH_VOICE="en-US-AvaMultilingualNeural"

# Optional Google login. A verified provider email still requires an invited account.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Password recovery: HTTPS endpoint accepting {to, subject, text} with Bearer auth.
# Invitations are shared manually by the administrator, not simulated email.
EMAIL_DELIVERY_URL=""
EMAIL_DELIVERY_TOKEN=""
