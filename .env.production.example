# PostgreSQL deployment. Generate the client and deploy migrations with this schema.
DATABASE_URL=""
PRISMA_SCHEMA_PATH="prisma/schema.postgres.prisma"
NEXTAUTH_URL="https://your-own-domain.example"
NEXTAUTH_SECRET=""
# Persistent private volume, never inside public/.
ARCADE_STORAGE_DIR="/var/lib/arcade"

# Optional capabilities. Empty values intentionally disable each provider.
AZURE_OPENAI_ENDPOINT=""
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_DEPLOYMENT=""
AZURE_OPENAI_API_VERSION="2024-10-21"
AZURE_SPEECH_KEY=""
AZURE_SPEECH_REGION=""
AZURE_SPEECH_VOICE="en-US-AvaMultilingualNeural"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
EMAIL_DELIVERY_URL=""
EMAIL_DELIVERY_TOKEN=""
